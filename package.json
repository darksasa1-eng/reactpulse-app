{
  "name": "reactpulse",
  "private": true,
  "version": "2.2.1",
  "description": "ReactPulse - Boost reactions on any WhatsApp Channel post, with channel blocking, owner verification and an admin control room. Powered by Sasa Dev API.",
  "author": "Sasa Dev",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "check:routes": "esbuild scripts/render-check.jsx --bundle --platform=node --format=cjs --outfile=.cache/render-check.cjs --loader:.css=empty --jsx=automatic && node .cache/render-check.cjs",
    "check:db": "node scripts/db-check.js",
    "seed:db": "node scripts/seed-db.js",
    "prerender": "esbuild scripts/prerender.jsx --bundle --platform=node --format=esm --outfile=.cache/prerender.mjs --loader:.css=empty --jsx=automatic --packages=external && node .cache/prerender.mjs",
    "prebuild": "node tools/decrypt-sources.mjs",
    "prestart": "node tools/decrypt-sources.mjs",
    "vault:encrypt": "node tools/encrypt-sources.mjs",
    "vault:decrypt": "node tools/decrypt-sources.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
