# ---------------------------------------------------------------------------
# ReactPulse environment variables  (v2)
# Copy this file to .env for local development (never commit the real .env)
# ---------------------------------------------------------------------------

# REQUIRED - your key from https://sasa-dev-api.xyz  (format: Sasa_Dev_Api_xxxxxxxx)
SASA_API_KEY=Sasa_Dev_Api_your_key_here

# Optional - upstream API origin and endpoint path
SASA_API_BASE=https://sasa-dev-api.xyz
SASA_REACTS_PATH=/api/wa-channel-reacts

# Optional - Render sets PORT automatically, keep it for local runs
PORT=3000

# --------------------------- canonical host / SEO --------------------------
# Everything that is not this host (onrender.com, www., http://) is 301'd here,
# so search engines only ever index one URL per page.
CANONICAL_HOST=reactpulse.sasatech.online
# Set DISABLE_HOST_REDIRECT=1 to switch the redirect off (useful locally)
# DISABLE_HOST_REDIRECT=1

# ------------------------------- admin panel -------------------------------
# The dashboard lives at this path (keep it secret, it is never linked publicly)
ADMIN_PATH=/sasa-admin-society
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Signs the admin session cookie (generated automatically and stored in the DB
# when you leave this empty - set it to keep sessions alive across restarts)
# ADMIN_SESSION_SECRET=

# --------------------------- JSON database persistence ---------------------
# Render's free plan has an ephemeral disk. With a GitHub token the database
# folder is mirrored into the private repo after every change and restored on
# the next boot, so blocked channels / stats / WhatsApp pairing survive redeploys.
GITHUB_TOKEN=
GITHUB_REPO=darksasa1-eng/reactpulse-database
GITHUB_BRANCH=main
# Set to 0 to disable the mirror completely
# GITHUB_DB_SYNC=1

# Optional - use a different database folder
# REACTPULSE_DB_DIR=/data/reactpulse

# ------------------------- anti-sleep keepalive ----------------------------
# The app pings itself while awake; the GitHub Actions workflow in
# .github/workflows/keepalive.yml pings /api/keepalive every 10 minutes.
KEEPALIVE=1          # 0 disables the internal watchdog
KEEPALIVE_INTERVAL_MS=600000
# KEEPALIVE_URL=https://reactpulse.sasatech.online/api/ping

# --------------------------- bot / scraper guard ---------------------------
# Allows search engines + uptime monitors, blocks AI crawlers, SEO scrapers,
# headless browsers and CLI tools. BOT_GUARD=0 disables it.
BOT_GUARD=1

# ------------------------- WhatsApp channel data ---------------------------
# WA_DEMO=1 serves deterministic sample channel metadata without pairing a phone
# (handy for local testing). Remove it in production.
# WA_DEMO=1
# WA_LOG_LEVEL=silent

# ---------------------------------- limits ---------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_EMOJIS=6
